{
  "name": "notificaciones-avisar",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/**\" dev",
    "dev:api": "pnpm --filter @avisar/api dev",
    "dev:web": "pnpm --filter @avisar/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @avisar/api test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @avisar/api db:migrate",
    "db:seed": "pnpm --filter @avisar/api db:seed",
    "db:studio": "pnpm --filter @avisar/api db:studio",
    "setup": "pnpm install && pnpm db:up && pnpm db:migrate && pnpm db:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3"
  }
}
