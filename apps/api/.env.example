# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches docker-compose.yml. Port 5433 avoids clashing with a local Postgres.
DATABASE_URL="postgresql://avisar:avisar@localhost:5433/avisar?schema=public"
# Neon supplies the pooled DATABASE_URL and this direct URL for migrations.
# DATABASE_URL_UNPOOLED="postgresql://.../neondb?sslmode=require"
# The CLI writes these to the workspace root .env.local (or existing .env).

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Public URL of the web client. Used to build the confirm/cancel links that
# are sent to patients, and to allow CORS.
WEB_APP_URL="http://localhost:5173"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_EXPIRES_IN="30d"

# ---------------------------------------------------------------------------
# Invoicing - available by default for all organizations
# ---------------------------------------------------------------------------
# Users configure their issuer from the app; no per-account activation needed.
# The default fake provider is for local simulation only. Production can start
# without a live provider, but issuance stays blocked until one is configured.
# INVOICING_ENABLED=false is an explicit deployment override.
# INVOICING_PROVIDER=fake
# Used only for customer-owned invoicing credentials. Reuse the stable key
# when already configured; changing it requires migrating encrypted data.
# INVOICING_CREDENTIAL_ENCRYPTION_KEY=<openssl rand -hex 32>

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# console = prints the WhatsApp message to the terminal (no credentials needed)
# meta    = all reminders use Avisar's centrally configured WhatsApp number
# twilio  = sends through the Twilio WhatsApp API
NOTIFICATION_PROVIDER=console

# How often the reminder job wakes up (standard cron expression).
REMINDER_CRON="* * * * *"
# Safety net: never send a reminder that became due more than N minutes ago.
REMINDER_MAX_DELAY_MINUTES=120
# How many reminders one job tick may send.
REMINDER_BATCH_SIZE=50
# How many times a failed reminder is retried before giving up.
REMINDER_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Twilio - only required when NOTIFICATION_PROVIDER=twilio
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox number for development: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# ---------------------------------------------------------------------------
# Central WhatsApp - Avisar owns the sender and approved template
# ---------------------------------------------------------------------------
# Complete these server-side values before switching NOTIFICATION_PROVIDER=meta.
# An incomplete central configuration blocks sending without using tenant keys.
# META_PHONE_NUMBER_ID=123456789012345
# META_ACCESS_TOKEN=your-central-sender-access-token
# META_APP_SECRET=your-meta-app-secret
# META_WEBHOOK_VERIFY_TOKEN=your-random-webhook-handshake-token
# The patient confirmation page must be reachable over public HTTPS.
# WEB_APP_URL=https://avisar.example
# META_API_VERSION=v21.0
# Parameter count and URL button must match the approved central template.
# META_TEMPLATE_NAME=recordatorio_turno
# META_TEMPLATE_LANGUAGE=es_AR
# META_TEMPLATE_PARAM_COUNT=4
# META_TEMPLATE_URL_BUTTON=true
