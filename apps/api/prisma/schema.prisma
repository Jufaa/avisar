// ---------------------------------------------------------------------------
// Avisar - appointment reminders for small health practices
//
// All nine tables are created up front, including the four that stay empty
// until the reminder feature ships. Adding them later, with live appointments
// already in the database, is the expensive path.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  SOLO
  CLINIC
}

/// How the account is used, which is a different question from what it pays.
///
/// SOLO   — one professional who manages their own agenda. The concept of
///          "professional" never appears in the interface: there is only "me".
/// CLINIC — several professionals managed by whoever runs the front desk.
enum AccountMode {
  SOLO
  CLINIC
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
}

enum NotificationChannel {
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  /// Claimed by a worker and handed to the provider. A row stuck here means
  /// the process died mid-send; boot recovery returns it to PENDING.
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum TemplateKind {
  REMINDER
  CONFIRMATION
}

enum ActionKind {
  CONFIRM
  CANCEL
}

/// What the practice is registered as before ARCA. It decides which invoice
/// types the account may issue at all, so it is asked once and stored, never
/// inferred from the amount or the customer.
enum TaxCondition {
  MONOTRIBUTO
  RESPONSABLE_INSCRIPTO
  EXENTO
}

/// The receiver's own standing before VAT. Together with the issuer's it is
/// what picks A over B; getting it wrong is a fiscal problem, not a bug.
enum ReceiverTaxCondition {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  CONSUMIDOR_FINAL
  EXENTO
}

/// Invoice class. A registered business invoicing another one issues A; the
/// same business invoicing a final consumer issues B. A monotributista only
/// ever issues C, and C never discriminates VAT.
enum InvoiceType {
  A
  B
  C
}

enum InvoiceStatus {
  /// Built and stored, seen by nobody. Nothing has left the building and the
  /// row can still be edited or deleted freely.
  DRAFT
  /// Handed to the provider. A row stuck here belongs to a process that died
  /// mid-issue, and must be reconciled before retrying: the CAE may exist.
  ISSUING
  /// Has a CAE. Legally emitted, and from here immutable — a mistake is
  /// corrected with a credit note, never by editing this row.
  ISSUED
  FAILED
  /// Superseded by a credit note.
  VOID
}

/// Identification the receiver was invoiced under. SIN_IDENTIFICAR covers the
/// walk-in consumer below the threshold that requires a document.
enum DocumentKind {
  CUIT
  CUIL
  DNI
  SIN_IDENTIFICAR
}

// ---------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------

model Organization {
  id       String @id @default(uuid())
  name     String
  /// IANA identifier, e.g. "America/Argentina/Buenos_Aires".
  /// The timezone is a stored fact, never an assumption of the server clock.
  timezone String @default("America/Argentina/Buenos_Aires")
  plan     Plan        @default(FREE)
  mode     AccountMode @default(SOLO)
  maxUsers Int         @default(1) @map("max_users")

  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  users         User[]
  professionals Professional[]
  patients      Patient[]
  appointments  Appointment[]
  templates     MessageTemplate[]
  reminderRules ReminderRule[]
  notifications Notification[]

  billingProfile BillingProfile?
  invoices       Invoice[]

  @@map("organization")
}

// ---------------------------------------------------------------------------
// Access
// ---------------------------------------------------------------------------

model User {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  lastLoginAt  DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional?

  @@index([organizationId])
  @@map("user")
}

// ---------------------------------------------------------------------------
// Agenda owners
// ---------------------------------------------------------------------------

model Professional {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  /// Null means "agenda without login": the professional is managed by the
  /// account owner and does not sign in. This is the whole multi-user story,
  /// deferred to a single nullable column.
  userId String? @unique @map("user_id")

  fullName           String  @map("full_name")
  specialty          String?
  defaultDurationMin Int     @default(30) @map("default_duration_min")
  /// Hex color used to tint the agenda.
  color              String  @default("#1F6E4E")
  active             Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments  Appointment[]
  reminderRules ReminderRule[]

  @@index([organizationId, active])
  @@map("professional")
}

// ---------------------------------------------------------------------------
// Contacts
// ---------------------------------------------------------------------------

model Patient {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  fullName String  @map("full_name")
  /// Always normalized to E.164 (+549...) at the edge of the API.
  /// Never stored the way it was typed.
  phoneE164 String @map("phone_e164")
  email     String?
  notes     String?

  whatsappOptIn Boolean @default(true) @map("whatsapp_opt_in")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  invoices     Invoice[]

  /// Stops the same person being created twice because the phone was typed
  /// with a different format.
  @@unique([organizationId, phoneE164])
  @@index([organizationId, fullName])
  @@map("patient")
}

// ---------------------------------------------------------------------------
// The appointment
// ---------------------------------------------------------------------------

model Appointment {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  professionalId String @map("professional_id")
  patientId      String @map("patient_id")

  /// A single instant, stored as timestamptz. Never a separate date + time:
  /// that pair is ambiguous the moment a timezone enters the picture.
  startsAt    DateTime          @map("starts_at") @db.Timestamptz(3)
  durationMin Int               @default(30) @map("duration_min")
  status      AppointmentStatus @default(PENDING)
  notes       String?

  cancelledAt   DateTime? @map("cancelled_at")
  cancelReason  String?   @map("cancel_reason")
  confirmedAt   DateTime? @map("confirmed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional Professional              @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  patient      Patient                   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  notifications Notification[]
  actionTokens  AppointmentActionToken[]
  invoices      Invoice[]

  /// Drives the agenda query: one professional over a date range.
  @@index([professionalId, startsAt])
  @@index([organizationId, startsAt])
  @@map("appointment")
}

// ---------------------------------------------------------------------------
// Reminders - created now, used from phase 4 onwards
// ---------------------------------------------------------------------------

model MessageTemplate {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  name String
  kind TemplateKind @default(REMINDER)
  /// Free text with {nombre_paciente}, {fecha}, {hora}, {profesional},
  /// {consultorio} and {link} placeholders.
  body String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reminderRules ReminderRule[]

  @@index([organizationId, kind])
  @@map("message_template")
}

model ReminderRule {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  /// Null applies the rule to every professional in the organization.
  /// A value overrides the organization default for that one agenda.
  professionalId String? @map("professional_id")
  templateId     String  @map("template_id")

  hoursBefore Int                 @map("hours_before")
  channel     NotificationChannel @default(WHATSAPP)
  enabled     Boolean             @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professional  Professional?  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  template      MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@unique([organizationId, professionalId, hoursBefore])
  @@index([organizationId, enabled])
  @@map("reminder_rule")
}

/// The outbox. A reminder that lives here survives a restart; a reminder that
/// lives in a setTimeout does not.
model Notification {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  appointmentId  String @map("appointment_id")
  ruleId         String @map("rule_id")

  channel      NotificationChannel @default(WHATSAPP)
  scheduledFor DateTime            @map("scheduled_for") @db.Timestamptz(3)
  status       NotificationStatus  @default(PENDING)
  attempts     Int                 @default(0)

  toPhone           String  @map("to_phone")
  renderedBody      String? @map("rendered_body")
  providerMessageId String? @map("provider_message_id")
  error             String?

  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  rule         ReminderRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  /// The constraint that keeps a patient from receiving the same reminder
  /// twice. Everything else about this feature is recoverable; that is not.
  @@unique([appointmentId, ruleId])
  /// Drives the job query and keeps it fast once SENT rows pile up.
  @@index([status, scheduledFor])
  @@index([organizationId, createdAt])
  @@map("notification")
}

/// One-shot opaque token behind the confirm / cancel link.
/// The appointment id never travels in a URL: it would let anyone iterate ids
/// and cancel other people's appointments.
model AppointmentActionToken {
  id            String @id @default(uuid())
  appointmentId String @map("appointment_id")

  token     String     @unique
  action    ActionKind
  expiresAt DateTime   @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?  @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_action_token")
}

// ---------------------------------------------------------------------------
// Invoicing
//
// A separate bounded context that happens to share a tenant. It knows nothing
// about agendas, and the agenda knows nothing about it: an invoice may point
// at an appointment, but never the other way round.
// ---------------------------------------------------------------------------

/// The account's fiscal identity. Split from `organization` on purpose: it
/// exists only once the practice actually invoices, and most of its columns
/// are meaningless until then.
model BillingProfile {
  id             String @id @default(uuid())
  organizationId String @unique @map("organization_id")

  /// Issuer CUIT, digits only.
  taxId        String       @map("tax_id")
  legalName    String       @map("legal_name")
  taxCondition TaxCondition @map("tax_condition")
  /// Point of sale registered with ARCA. Numbering is per point of sale, so
  /// this is not cosmetic: changing it starts a new sequence.
  salesPoint   Int          @map("sales_point")

  /// Commercial address. Required on the printed document by RG 1415, so it
  /// is asked once here rather than discovered missing at print time.
  address           String?   @map("address")
  grossIncomeId     String?   @map("gross_income_id")
  activityStartedOn DateTime? @map("activity_started_on") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("billing_profile")
}

model Invoice {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  type   InvoiceType
  status InvoiceStatus @default(DRAFT)

  /// Copied from the billing profile at draft time rather than joined at read
  /// time. An issued invoice must keep saying what it said the day it was
  /// issued, even if the practice later changes point of sale or condition.
  salesPoint Int      @map("sales_point")
  /// Assigned by ARCA on issue, never chosen here.
  number     Int?
  issuedOn   DateTime @map("issued_on") @db.Date

  receiverName         String               @map("receiver_name")
  receiverDocKind      DocumentKind         @map("receiver_doc_kind")
  receiverDocNumber    String               @map("receiver_doc_number")
  receiverTaxCondition ReceiverTaxCondition @map("receiver_tax_condition")
  /// Required by the provider, not by us. Null becomes a dash on the way out.
  receiverAddress      String?              @map("receiver_address")

  /// Money is Decimal, never Float. A binary float cannot hold 0.10 exactly,
  /// and a rounding error on a fiscal document is not a rounding error.
  subtotal  Decimal @db.Decimal(14, 2)
  vatAmount Decimal @map("vat_amount") @db.Decimal(14, 2)
  total     Decimal @db.Decimal(14, 2)
  currency  String  @default("ARS")

  /// What ARCA gave back. Their presence is what makes the invoice real.
  cae          String?
  caeExpiresOn DateTime? @map("cae_expires_on") @db.Date
  pdfUrl       String?   @map("pdf_url")
  /// The provider's own id for this document, kept for reconciliation.
  providerRef  String?   @map("provider_ref")

  attempts Int     @default(0)
  error    String?

  /// Both optional: an invoice may bill an appointment, a patient with no
  /// appointment, or a walk-in who is neither.
  patientId     String? @map("patient_id")
  appointmentId String? @map("appointment_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  issuedAt  DateTime? @map("issued_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]

  /// Two issued invoices can never share a number within a point of sale.
  /// Partial by intent: drafts have no number and must not collide.
  @@unique([organizationId, salesPoint, type, number])
  @@index([organizationId, status, issuedOn])
  @@index([patientId])
  @@map("invoice")
}

model InvoiceItem {
  id        String @id @default(uuid())
  invoiceId String @map("invoice_id")

  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  /// Percentage: 21, 10.5, 0. Stored per line because one invoice may mix
  /// rates, and the total alone cannot be re-derived without it.
  vatRate     Decimal @map("vat_rate") @db.Decimal(5, 2)

  subtotal  Decimal @db.Decimal(14, 2)
  vatAmount Decimal @map("vat_amount") @db.Decimal(14, 2)
  total     Decimal @db.Decimal(14, 2)

  position Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_item")
}
